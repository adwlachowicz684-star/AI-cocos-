{
  "name": "cocos-kit",
  "version": "0.39.0",
  "description": "Cocos 通用插件库：零业务依赖、可随时导入与卸载的通用功能集合",
  "engine": "cocos-creator >= 3.6",
  "language": "typescript",
  "principle": {
    "rule1": "零业务依赖：插件里不得出现任何游戏专属概念",
    "rule2": "依赖注入：需要外部对象时由调用方传入，插件内部不得去「找」",
    "rule3": "单一职责：一个插件只解决一个问题",
    "rule4": "配置驱动：所有可调参数进配置对象",
    "rule5": "可卸载：必须提供 destroy()，卸载后不留残留",
    "rule6": "禁止横向依赖：插件之间不得互相 import（_core 除外）",
    "rule7": "每个插件自带 README + 测试 + 示例",
    "judge": "把这个插件的文件夹复制到另一个 Cocos 项目，需要改几行？答案是 0 才算合格"
  },
  "_core_policy": {
    "description": "_core 是 rule6 的唯一例外，准入条件极严",
    "requirements": [
      "无任何状态",
      "无副作用",
      "不需要配置",
      "不 import 引擎或业务模块"
    ],
    "note": "一旦某个工具需要状态或配置，它就应该成为独立插件"
  },
  "plugins": [
